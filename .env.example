# Server port (backend)
PORT=3001

# Secret for signing JWT tokens — change this in production
JWT_SECRET=change-me-in-production

# OpenRouteService API key for geocoding and routing (optional)
# Sign up at https://openrouteservice.org/dev/#/signup
# Without this, address search is disabled but manual distance entry still works
ORS_API_KEY=

# Path to the SQLite database file (optional, defaults to ./data/routecalc.db)
DATABASE_PATH=
